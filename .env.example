# Application
APP_NAME=Backend Core
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# Dominio raiz usado para derivar el "domain" de celulas/servicios
# (ej. [celula].andrescortes.dev, [servicio].[celula].andrescortes.dev)
APP_ROOT_DOMAIN=andrescortes.dev
# A donde redirige /auth/{provider}/callback tras el login (exito o error).
# El frontend debe tener una ruta cliente en {APP_FRONTEND_URL}/auth/callback
# que lea ?access_token=... o ?error=...&error_description=... del query string.
APP_FRONTEND_URL=http://localhost:5173

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8000
CORS_ALLOW_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?$
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type

# JWT
JWT_SECRET_KEY=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_MINUTES=1440
JWT_ISSUER=
JWT_AUDIENCE=

# SQL Server
# IMPORTANTE: usar el usuario app_backend (EXECUTE/SELECT sobre SPs, Views y
# Functions unicamente; DENY sobre las tablas). Nunca el usuario administrador
# ni un usuario con permisos amplios sobre el schema -- ver 08_seguridad_permisos.sql
# y 17_fix_app_backend.sql. Esa restriccion es la que hace cumplir en serio la
# regla de "el backend nunca toca una tabla directo".
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=MessageBrokerDB
SQLSERVER_USER=app_backend
SQLSERVER_PASSWORD=replace-me
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=yes

# Optional override. Leave empty unless you need a fully custom ODBC string.
SQLSERVER_CONNECTION_STRING=
SQLSERVER_SP_TIMEOUT_SECONDS=30

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_USERINFO_URL=https://api.github.com/user
GITHUB_EMAILS_URL=https://api.github.com/user/emails

# OAuth state cookie
OAUTH_STATE_COOKIE_SECURE=true
OAUTH_STATE_COOKIE_SAMESITE=lax
OAUTH_STATE_TTL_SECONDS=600

# Database provisioning (provisioner/ sidecar -- the only process with
# Docker socket access; this backend calls it over internal_net).
# PROVISIONING_SHARED_SECRET must match the sidecar's own .env.provisioner.
PROVISIONING_BASE_URL=http://provisioner:9000
PROVISIONING_SHARED_SECRET=replace-with-a-strong-random-secret
PROVISIONING_REQUEST_TIMEOUT_SECONDS=90
# VPS's externally-reachable address (raw TCP, NOT the "provisioner" hostname) --
# returned to end users as the `host` they connect their own apps to.
PROVISIONING_PUBLIC_HOST=
PROVISIONING_PORT_RANGE_START=30000
PROVISIONING_PORT_RANGE_END=40000
PROVISIONING_PORT_ALLOCATION_ATTEMPTS=5
PROVISIONING_PASSWORD_LENGTH=24
PROVISIONING_SUPPORTED_ENGINES=MYSQL
