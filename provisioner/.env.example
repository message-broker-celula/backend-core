# Must match PROVISIONING_SHARED_SECRET in the backend's own .env
SHARED_SECRET=replace-with-a-strong-random-secret

DOCKER_NETWORK=provisioned_net
# 256m OOM-kills MySQL 8.4 on startup (confirmed against a real crash loop) -- 512m is the safe floor.
CONTAINER_MEM_LIMIT=512m
CONTAINER_CPU_LIMIT=0.5
HOST_BIND_ADDRESS=0.0.0.0
# 30s can be too tight against real MySQL first-boot latency under load -- confirmed in production.
READINESS_TIMEOUT_SECONDS=60
READINESS_POLL_INTERVAL_SECONDS=1.0
